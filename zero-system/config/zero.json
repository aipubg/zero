{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "none"
    },
    "reload": {
      "mode": "hybrid"
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "google": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "api": "openai-completions",
        "models": [
          {
            "id": "models/gemini-2.5-flash",
            "name": "Gemini 2.5 Flash",
            "reasoning": false,
            "image": true
          },
          {
            "id": "models/gemini-flash-lite-latest",
            "name": "Gemini Flash Lite Latest",
            "reasoning": false,
            "image": true
          }
        ],
        "apiKey": "env:GEMINI_API_KEY",
        "apiKeys": [
          "env:GEMINI_API_KEY"
        ],
        "enabled": true
      },
      "nv": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/nemotron-3.5-super-vl-120b-a12b",
            "name": "nvidia/nemotron-3.5-super-vl-120b-a12b",
            "reasoning": false,
            "image": false
          },
          {
            "id": "nvidia/nemotron-3-super-120b-a12b",
            "name": "nvidia/nemotron-3-super-120b-a12b",
            "reasoning": false,
            "image": false
          },
          {
            "id": "minimaxai/minimax-m3.1-flash",
            "name": "minimaxai/minimax-m3.1-flash",
            "reasoning": false,
            "image": false
          },
          {
            "id": "openai/gpt-oss-20b",
            "name": "openai/gpt-oss-20b",
            "reasoning": false,
            "image": false
          },
          {
            "id": "deepseek-ai/deepseek-v4.1-flash",
            "name": "deepseek-ai/deepseek-v4.1-flash",
            "reasoning": false,
            "image": false
          }
        ],
        "apiKey": "env:NV_API_KEY",
        "apiKeys": [
          "env:NV_API_KEY"
        ],
        "enabled": true
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "zero"
      },
      "model": {
        "primary": null
      },
      "skills": [],
      "sandbox": {
        "mode": "off"
      }
    },
    "entries": {
      "zero": {
        "name": "Zero",
        "workspace": "E:\\\\zero\\\\zero-system\\\\state\\\\agents\\\\zero",
        "identity": {
          "name": "Zero"
        },
        "tools": {
          "profile": "full",
          "alsoAllow": [
            "computer",
            "zero_computer",
            "zero_computer_action",
            "zero_screen_context",
            "browser",
            "open_browser",
            "open_url",
            "web_search"
          ],
          "exec": {
            "mode": "full"
          }
        },
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true
        },
        "model": {
          "primary": null
        }
      }
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "main",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 5000,
      "maxDiskBytes": "2gb"
    }
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "E:\\zero\\app\\zero-control-ui"
      ]
    },
    "entries": {
      "cua-computer": {
        "enabled": true
      },
      "zero-control-ui": {
        "enabled": false,
        "config": {
          "controlMethodName": "zero.computer.control",
          "holdToolNames": [
            "computer",
            "zero_computer"
          ],
          "codeModeToolNames": [
            "exec"
          ],
          "observeActions": [
            "screenshot",
            "wait",
            "list_apps",
            "list_windows",
            "get_accessibility_tree",
            "get_cursor_position",
            "get_window_state",
            "zoom",
            "get_browser_state",
            "get_recording_state"
          ],
          "blockedActions": [
            "escalate_scope"
          ],
          "highRiskActions": [
            "kill_app",
            "browser_navigate",
            "browser_download",
            "browser_set_input_files",
            "start_recording",
            "replay_trajectory",
            "escalate_scope"
          ],
          "maxActionsPerRun": 400,
          "maxInputActionsPerRun": 200,
          "requireFreshSnapshotAfterRelease": true
        }
      }
    }
  },
  "update": {
    "channel": "stable",
    "auto": {
      "enabled": false
    }
  },
  "telemetry": {
    "enabled": false
  },
  "tools": {
    "profile": "full"
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.6"
  },
  "ui": {
    "prefs": {
      "themeMode": "dark",
      "theme": null,
      "accent": "theme"
    }
  }
}
