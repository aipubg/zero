{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "none"
    },
    "reload": {
      "mode": "hybrid"
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "nv": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/nemotron-3.5-super-vl-120b-a12b",
            "name": "nvidia/nemotron-3.5-super-vl-120b-a12b",
            "reasoning": false,
            "image": false
          }
        ],
        "apiKey": "env:NV_API_KEY",
        "apiKeys": [
          "env:NV_API_KEY"
        ],
        "enabled": true
      },
      "gemini-live-screen": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "api": "openai-completions",
        "models": [],
        "apiKey": "env:GEMINI_LIVE_SCREEN_API_KEY",
        "apiKeys": [
          "env:GEMINI_LIVE_SCREEN_API_KEY"
        ],
        "enabled": true
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "zero"
      },
      "model": {
        "primary": null
      },
      "skills": [],
      "sandbox": {
        "mode": "off"
      }
    },
    "entries": {
      "zero": {
        "name": "Zero",
        "workspace": "E:\\\\zero\\\\zero-system\\\\state\\\\agents\\\\zero",
        "identity": {
          "name": "Zero"
        },
        "tools": {
          "profile": "full",
          "alsoAllow": [
            "computer",
            "zero_computer",
            "zero_computer_action",
            "zero_screen_context",
            "browser",
            "open_browser",
            "open_url",
            "web_search"
          ],
          "exec": {
            "mode": "full"
          }
        },
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true
        },
        "model": {
          "primary": null
        }
      }
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "main",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 5000,
      "maxDiskBytes": "2gb"
    }
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "plugins": {
    "load": {
      "paths": []
    },
    "entries": {
      "cua-computer": {
        "enabled": true
      }
    }
  },
  "update": {
    "channel": "stable",
    "auto": {
      "enabled": false
    }
  },
  "telemetry": {
    "enabled": false
  },
  "tools": {
    "profile": "full"
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.6"
  },
  "ui": {
    "prefs": {
      "themeMode": "light",
      "theme": null,
      "accent": "theme"
    }
  },
  "patch": {}
}
