{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "none"
    },
    "reload": {
      "mode": "hybrid"
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "nv": {
        "baseUrl": "http://127.0.0.1:18789/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/nemotron-3-super-120b-a12b",
            "name": "3-super-120b-a12b"
          },
          {
            "id": "nvidia/nemotron-3-ultra-550b-a55b",
            "name": "3-ultra-550b-a55b"
          },
          {
            "id": "nvidia/nemotron-3.5-lightning-30b-a3b",
            "name": "3.5-lightning-30b-a3b"
          },
          {
            "id": "nvidia/nemotron-3.5-super-vl-120b-a12b",
            "name": "3.5-super-vl-120b-a12b"
          }
        ],
        "apiKey": "env:NVIDIA_API_KEY"
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "zero"
      },
      "model": {
        "primary": "nv/nvidia/nemotron-3.5-lightning-30b-a3b",
        "fallbacks": [
          "nv/nvidia/nemotron-3-ultra-550b-a55b"
        ]
      },
      "utilityModel": "nv/nvidia/nemotron-3.5-lightning-30b-a3b",
      "skills": [],
      "sandbox": {
        "mode": "off"
      }
    },
    "entries": {
      "zero": {
        "name": "Zero",
        "workspace": "E:\\\\zero\\\\zero-system\\\\state\\\\agents\\\\zero",
        "identity": {
          "name": "Zero"
        },
        "tools": {
          "profile": "full",
          "alsoAllow": [
            "computer",
            "zero_computer",
            "zero_computer_action",
            "zero_screen_context"
          ],
          "exec": {
            "mode": "ask"
          }
        },
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true
        },
        "model": {
          "primary": "nv/nvidia/nemotron-3.5-lightning-30b-a3b",
          "fallbacks": [
            "nv/nvidia/nemotron-3-ultra-550b-a55b"
          ]
        }
      }
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "main",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 5000,
      "maxDiskBytes": "2gb"
    }
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "plugins": {
    "load": {
      "paths": []
    },
    "entries": {
      "cua-computer": {
        "enabled": true
      }
    }
  },
  "update": {
    "channel": "stable",
    "auto": {
      "enabled": false
    }
  },
  "telemetry": {
    "enabled": false
  },
  "tools": {
    "profile": "full"
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.10.6"
  }
}
