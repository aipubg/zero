{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "none"
    },
    "reload": {
      "mode": "hybrid"
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {}
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "zero"
      },
      "skills": [],
      "sandbox": {
        "mode": "off"
      }
    },
    "entries": {
      "zero": {
        "name": "Zero",
        "workspace": "E:\\\\zero\\\\zero-system\\\\state\\\\agents\\\\zero",
        "identity": {
          "name": "Zero"
        },
        "tools": {
          "profile": "full",
          "alsoAllow": [
            "computer",
            "zero_computer",
            "zero_computer_action",
            "zero_screen_context"
          ],
          "exec": {
            "mode": "ask"
          }
        },
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true
        },
        "model": {}
      }
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "main",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 5000,
      "maxDiskBytes": "2gb"
    }
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "plugins": {
    "load": {
      "paths": []
    },
    "entries": {
      "cua-computer": {
        "enabled": true
      }
    }
  },
  "update": {
    "channel": "stable",
    "auto": {
      "enabled": false
    }
  },
  "telemetry": {
    "enabled": false
  }
}
