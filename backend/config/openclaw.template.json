{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "none"
    },
    "reload": {
      "mode": "hybrid"
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "zero-gateway": {
        "baseUrl": "http://127.0.0.1:18790/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "test-model-1",
            "name": "test-model-1 (Primary)"
          },
          {
            "id": "@fast",
            "name": "test-model-1 (@fast)"
          },
          {
            "id": "@coder",
            "name": "test-model-1 (@coder)"
          },
          {
            "id": "@reasoning",
            "name": "test-model-1 (@reasoning)"
          }
        ]
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "zero"
      },
      "model": {
        "primary": "test-model-1",
        "fallbacks": [
          "default"
        ]
      },
      "utilityModel": "default",
      "skills": [],
      "sandbox": {
        "mode": "off"
      }
    },
    "entries": {
      "zero": {
        "name": "Zero",
        "workspace": "E:\\zero\\backend\\.openclaw\\agents\\zero",
        "identity": {
          "name": "Zero"
        },
        "tools": {
          "profile": "coding",
          "alsoAllow": [
            "computer",
            "zero_computer",
            "zero_computer_action",
            "zero_screen_context"
          ],
          "exec": {
            "mode": "ask"
          }
        },
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true
        },
        "model": {
          "primary": "test-model-1",
          "allowUnverifiedOverride": true
        }
      }
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "main",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 5000,
      "maxDiskBytes": "2gb"
    }
  },
  "memory": {
    "search": {
      "provider": "none"
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "E:\\zero\\app\\zero-control-ui"
      ]
    },
    "entries": {
      "zero-control-ui": {
        "enabled": true,
        "config": {
          "controlMethodName": "zero.computer.control",
          "holdToolNames": [
            "computer"
          ],
          "codeModeToolNames": [
            "exec"
          ],
          "observeActions": [
            "screenshot",
            "wait",
            "list_apps",
            "list_windows",
            "get_accessibility_tree",
            "get_cursor_position",
            "get_window_state",
            "zoom",
            "get_browser_state",
            "get_recording_state"
          ],
          "blockedActions": [
            "escalate_scope"
          ],
          "highRiskActions": [
            "kill_app",
            "browser_navigate",
            "browser_download",
            "browser_set_input_files",
            "start_recording",
            "replay_trajectory",
            "escalate_scope"
          ],
          "maxActionsPerRun": 400,
          "maxInputActionsPerRun": 200,
          "requireFreshSnapshotAfterRelease": true
        }
      }
    }
  }
}