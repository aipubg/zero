# Zero backend runtime environment (names only — never commit values)

# --- OpenClaw Gateway auth (read directly by OpenClaw) ----------------------
# Gateway auth is disabled in the local Zero instance; no token is required.

# --- runtime isolation: keep Zero state out of the user profile -------------
OPENCLAW_STATE_DIR=E:\zero\backend\.openclaw
OPENCLAW_CONFIG_PATH=E:\zero\backend\config\openclaw.json
