{
  "id": "zero-control-ui",
  "name": "Zero",
  "description": "Zero: unified private assistant over the local Gateway, with native Control UI, computer hold policy, and observation context.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "controlMethodName": {
        "type": "string"
      },
      "holdToolNames": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "codeModeToolNames": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "observeActions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "blockedActions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "highRiskActions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxActionsPerRun": {
        "type": "integer",
        "minimum": 1
      },
      "maxInputActionsPerRun": {
        "type": "integer",
        "minimum": 0
      },
      "requireFreshSnapshotAfterRelease": {
        "type": "boolean"
      },
      "observationSuggestions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "minEvidence": {
            "type": "integer",
            "minimum": 2,
            "maximum": 50,
            "default": 3
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 600
          },
          "maxSuggestions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 3
          }
        }
      }
    }
  },
  "uiCapabilities": [],
  "activation": {
    "onStartup": true
  },
  "controlUi": {
    "entry": "dist/control-ui/cf08eadbc98e72df152059a46886c31046dc85d032fd9b3dda938b31864da890/index.js",
    "styles": [
      "dist/control-ui/cf08eadbc98e72df152059a46886c31046dc85d032fd9b3dda938b31864da890/index.css"
    ]
  },
  "contracts": {
